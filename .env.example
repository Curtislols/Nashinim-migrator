# Copy this to .env and fill in your values

# API key clients must send in the X-API-Key header.
# Leave empty to disable auth (development only).
API_KEY=your-secret-key-here

# Comma-separated list of allowed CORS origins.
# Use * to allow all (not recommended for production).
CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Max simultaneous scraping jobs.
# Each Playwright job can use ~200-400MB RAM, so size this to your server.
MAX_CONCURRENT_JOBS=3
